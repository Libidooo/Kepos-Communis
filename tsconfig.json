{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmitOnError": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "terminal/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "recovery"
  ]
}
